{
  "name": "superlabs-backend",
  "version": "1.0.0",
  "description": "SuperLabs Backend Developer Task - product listing service",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "postinstall": "prisma generate",
    "render:build": "prisma migrate deploy && node prisma/seed.js",
