generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  description   String
  brand         String
  price         Float
  originalPrice Float?
  image         String?
  sku           String   @unique
  rating        Float    @default(0)
  reviews       Int      @default(0)
  availability  Boolean  @default(true)
  createdAt     DateTime @default(now())
}
